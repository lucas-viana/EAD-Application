# Copie para .env e preencha. O arquivo .env não deve ser versionado.

# ---------------------------------------------------------------------------
# Banco de dados — Supabase
# Painel do Supabase → Connect → "Session pooler" (porta 5432, compatível com IPv4).
# Converta a URI para JDBC: jdbc:postgresql://HOST:5432/postgres?sslmode=require
# O usuário do pooler tem o formato postgres.<project-ref>.
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.SEU_PROJECT_REF
DATABASE_PASSWORD=SENHA_DO_BANCO
DATABASE_POOL_SIZE=5

# Alternativa: PostgreSQL local do docker compose (docker compose --profile local-db up --build)
# DATABASE_URL=jdbc:postgresql://db:5432/postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Porta publicada pelo front-end (http://localhost:8080)
WEB_PORT=8080
# Endereço público do site, usado no link de recuperação de acesso
PUBLIC_BASE_URL=http://localhost:8080
# true em produção (HTTPS). false permite testar em http://localhost em qualquer navegador.
COOKIE_SECURE=false
# Duração da sessão (ISO-8601): 14 dias
SESSION_TTL=P14D
# E-mails com perfil de administração, separados por vírgula
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Vídeos protegidos
# VIDEO_PROVIDER=local    → arquivos em ./media/videos, entregues por URL assinada
# VIDEO_PROVIDER=supabase → bucket privado do Supabase Storage (URL assinada pelo Supabase)
# ---------------------------------------------------------------------------
VIDEO_PROVIDER=local
VIDEO_URL_TTL=PT15M
# Gere um valor aleatório longo, por exemplo: openssl rand -base64 48
MEDIA_SIGNING_SECRET=
SUPABASE_URL=
# Chave service_role: fica somente no servidor, nunca no front-end
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=videos

# ---------------------------------------------------------------------------
# E-mail de recuperação (SMTP). Sem SMTP_HOST, o link aparece no log da API.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Informática Básica <nao-responda@seu-dominio.com.br>
